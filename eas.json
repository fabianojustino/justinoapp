{
  "cli": {
    "version": ">= 16.3.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal"
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "preview-store": {
      "channel": "preview",
      "distribution": "store"
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "production-internal": {
      "extends": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "craw": {
      "distribution": "internal",
      "channel": "craw"
    }
  },
  "submit": {
    "production": {}
  }
}
